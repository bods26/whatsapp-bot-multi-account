{
  "name": "whatsapp-bot-multi-account",
  "version": "1.0.0",
  "description": "WhatsApp Bot Multi-Account with Telegram Dashboard",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "server": "node server.js",
    "cli": "node cli.js",
    "setup": "node setup.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "pm2:start": "pm2 start ecosystem.config.js",
